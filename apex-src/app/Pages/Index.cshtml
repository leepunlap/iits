@page "/"
@using System.Linq
@using IitsNews.Data
@model IitsNews.Pages.IndexModel
@{
    var L = Model.CurrentLang;
    var leadT = Model.Lead?.For(L);
    var leadImg = leadT.FirstImage();
}

@* Hero taken from the live iits.giftedintl.com, verbatim in structure and values —
   pill badge, split headline with the second line in brand blue, the two-photo stack with
   its floating stat card. Only the copy is parameterised, so it reads in all three
   languages instead of being frozen in Traditional. *@
<header style="position:relative;padding:clamp(40px,5vw,68px) 0 clamp(30px,4vw,40px)">
  <div class="shell">
    <div class="hero-grid">
      <div>
        <div class="hero-badge">
          <span style="display:inline-block;width:7px;height:7px;border-radius:999px;background:var(--brand)"></span>@Ui.T(L,"heroBadge")
        </div>
        <h1 class="hero-h1" style="font-family:var(--serif);font-weight:900;
                   line-height:1.06;letter-spacing:-1px;margin:0 0 30px;color:var(--ink)">
          @Ui.T(L,"heroA")<br><span style="color:var(--brand)">@Ui.T(L,"heroB")</span>
        </h1>
        <p style="font-size:18px;line-height:1.85;color:var(--muted3);max-width:520px;
                  margin:0 0 40px;font-weight:300">@Ui.T(L,"heroP")</p>
        <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap">
          <a href="/c/courses?lang=@L" class="pill-cta">@Ui.T(L,"heroCta1")</a>
          <a href="/c/about?lang=@L" class="pill-cta2">@Ui.T(L,"heroCta2")</a>
        </div>
      </div>
      <div class="hero-art">
        @* Two independent slideshows. The frames carry DIFFERENT sets so the big and the
           small photo are never the same shot, and the small one is offset by half the
           interval so they do not flip in unison. *@
        <div class="hero-a slides" data-interval="10000">
          @foreach (var (f, i) in new[]{"hero1","hero5","hero2"}.Select((f,i)=>(f,i)))
          {
            <img src="/assets/@(f).jpg@(Ui.V($"/assets/{f}.jpg"))" alt=""
                 class="@(i == 0 ? "on" : "")" loading="@(i == 0 ? "eager" : "lazy")" decoding="async">
          }
        </div>
        <div class="hero-b slides" data-interval="10000" data-offset="5000">
          @foreach (var (f, i) in new[]{"hero3","hero6","hero4"}.Select((f,i)=>(f,i)))
          {
            <img src="/assets/@(f).jpg@(Ui.V($"/assets/{f}.jpg"))" alt=""
                 class="@(i == 0 ? "on" : "")" loading="@(i == 0 ? "eager" : "lazy")" decoding="async">
          }
        </div>
        <div class="hero-stat">
          <div style="font-family:var(--serif);font-weight:900;font-size:28px;line-height:1;color:#AEBDE3">5</div>
          <div style="font-size:11.5px;color:#B3BCCB;margin-top:5px;font-family:var(--mono);letter-spacing:.5px">@Ui.T(L,"heroStat")</div>
        </div>
      </div>
    </div>
  </div>
</header>

<section id="tests" class="sec">
  <div class="sechead">
    <div>
      <div class="eyebrow">ASSESSMENTS</div>
      <h2 class="h2">@Ui.T(L,"assessments")</h2>
    </div>
    <p class="lede">@Ui.T(L,"assessLede")</p>
  </div>
  <div class="grid cols-a swipe">
    @foreach (var t in Model.Tracks)
    {
      <div class="cell">
        @* An actual cube — the old badge was that same cube drawn flat in isometric
           projection. Every face carries the code, so it reads at any angle of the turn. *@
        @* Plain card behind the cube. The track illustrations went in here and came back
           out: even greyscaled and washed to 40%, an isometric scene behind a tumbling glass
           cube gives the eye two things to read in one small square. The cube IS the
           identifier; it does not need a backdrop to explain it. *@
        <div style="height:150px;border-bottom:1px solid var(--line);display:flex;
                    align-items:center;justify-content:center;background:var(--card)">
          <div class="cube-stage" role="img" aria-label="@t.Code" tabindex="0">
            <div class="cube">
              <i class="f"></i><i class="b"></i><i class="r"></i>
              <i class="l"></i><i class="u"></i><i class="d"></i>
              <span class="lbl"><b>@t.Code</b></span>
            </div>
          </div>
        </div>
        <div style="padding:24px 22px">
          @{ var tn = Ui.TrackName(L, t.Code); }
          <h3 style="font-family:var(--serif);font-size:16.5px;font-weight:700;margin:0 0 16px;
                     color:var(--ink2);line-height:1.55">
            @tn.A<br>@tn.B
          </h3>
          <a href="/c/tests?lang=@L#@t.Code" style="font-size:13.5px;letter-spacing:.05em">@Ui.T(L,"enter")</a>
        </div>
      </div>
    }
  </div>
  <div class="swipehint">@Ui.T(L,"swipe")</div>
</section>

<section id="news" style="background:var(--panel);border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
  <div class="sec">
    <div class="sechead" style="margin-bottom:48px">
      <div>
        <div class="eyebrow">NEWS</div>
        <h2 class="h2">@Ui.T(L,"news")</h2>
      </div>
      <a class="more" href="/c/news?lang=@L">@Ui.T(L,"more")</a>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:56px">
      @* The date and headline sit ON the picture behind a scrim, and the frame cycles the
         latest posts. Previously one fixed photo carried a caption below it, which left the
         other recent stories with nothing but a one-line row. *@
      @if (Model.LeadSlides.Count > 0)
      {
        <div class="newshero slides" data-interval="15000">
          @foreach (var (a, i) in Model.LeadSlides.Select((a, i) => (a, i)))
          {
            var t = a.For(L); var img = t.FirstImage();
            <a class="@(i == 0 ? "on" : "")" href="/news/item/@a.Id?lang=@L"
               style="background-image:url('@img')" aria-hidden="@(i == 0 ? "false" : "true")">
              <span class="cap">
                <span class="meta">@(a.PublishedAt?.ToString("yyyy-MM-dd") ?? "")</span>
                <span class="ttl">@(string.IsNullOrWhiteSpace(t?.Title) ? Ui.T(L,"untitled") : t!.Title)</span>
              </span>
            </a>
          }
          <div class="dots" aria-hidden="true">
            @for (var i = 0; i < Model.LeadSlides.Count; i++) { <span class="@(i == 0 ? "on" : "")"></span> }
          </div>
        </div>
      }

      <div style="display:flex;flex-direction:column">
        @foreach (var a in Model.NewsList)
        {
          var t = a.For(L);
          <a href="/news/item/@a.Id?lang=@L" style="display:flex;gap:18px;padding:16px 0;
             border-bottom:1px solid var(--line);color:inherit">
            <span class="meta" style="flex-shrink:0;padding-top:4px;width:76px">@(a.PublishedAt?.ToString("yyyy-MM-dd"))</span>
            <span style="font-size:14.5px;line-height:1.7;text-wrap:pretty">@t?.Title</span>
          </a>
        }
      </div>
    </div>
  </div>
</section>
<script src="/assets/js/cube.js@(Ui.V("/assets/js/cube.js"))" defer></script>

@* The partner logo wall lives on About, under its own anchor. It was on both pages, which
   is one wall too many — the home page already links to About in the menu. *@
