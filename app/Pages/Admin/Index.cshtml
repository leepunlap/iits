@page "/admin"
@model IitsNews.Pages.Admin.IndexModel

<h1>文章管理</h1>
<p class="muted">
    登入身分 @Model.Who ·
    草稿 @Model.CountDraft · 已發布 @Model.CountPublished ·
    <a href="/admin/edit/0">新增文章</a>
</p>

<form method="get" style="margin-bottom:1rem; display:flex; gap:.5rem; flex-wrap:wrap;">
    <select name="kind" style="max-width:14rem">
        <option value="article"  selected="@(Model.Filter == "article")">文章 article</option>
        <option value="pageBody" selected="@(Model.Filter == "pageBody")">頁面內容 pageBody</option>
        <option value="empty"    selected="@(Model.Filter == "empty")">空白 empty</option>
        <option value="all"      selected="@(Model.Filter == "all")">全部 all</option>
    </select>
    <input type="text" name="q" placeholder="搜尋標題" style="max-width:18rem" />
    <button type="submit">篩選</button>
</form>

<table>
    <thead>
        <tr><th>#</th><th>標題</th><th>語言版本</th><th>日期</th><th>狀態</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var a in Model.Items)
    {
        var primary = a.For(IitsNews.Data.Lang.Hant);
        <tr>
            <td class="muted">@(a.LegacyId?.ToString() ?? "new")</td>
            <td>@(primary?.Title ?? "—")</td>
            <td>
                @foreach (var l in IitsNews.Data.Lang.All)
                {
                    var tr = a.Translations.FirstOrDefault(x => x.Lang == l);
                    if (tr is null)
                    {
                        <span class="pill">@IitsNews.Data.Lang.Label(l) —</span>
                    }
                    else
                    {
                        <span class="pill">@IitsNews.Data.Lang.Label(l)@(tr.Provenance == "machine" ? " ⚙" : "")</span>
                    }
                }
            </td>
            <td class="muted">@(a.PublishedAt?.ToString("yyyy-MM-dd") ?? "—")</td>
            <td>@(a.Status == "published" ? "已發布" : "草稿")</td>
            <td><a href="/admin/edit/@a.Id">編輯</a></td>
        </tr>
    }
    </tbody>
</table>

@if (Model.Items.Count == 0)
{
    <p class="muted">沒有符合的項目。</p>
}
