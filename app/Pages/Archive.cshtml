@page "/c/{cat}/{sub}"
@using IitsNews.Data
@using IitsNews.Services
@model IitsNews.Pages.ArchiveModel
@{ var L = Model.CurrentLang; }

<section class="sec">
  <h1 class="h2" style="margin-bottom:12px">@(Model.Sub is null ? Taxonomy.Name(Model.Cat, L) : Taxonomy.Name(Model.Sub, L))</h1>
  <p class="lede" style="margin-bottom:34px">@Model.Total @Ui.T(L,"items") ·
    <a href="/c/@Model.Cat.Key?lang=@L#@(Model.Sub?.Key)">@Ui.T(L,"backToSection")</a></p>

  @if (Model.Items.Count > 0)
  {
    @if (Model.Kind == "partner")
    {
      <div class="logogrid">
        @foreach (var a in Model.Items)
        {
          var t = a.For(L); var img = t.FirstImage();
          <div class="logo">@if (img is not null) { <img src="@img" alt="@t?.Title" loading="lazy"> } else { <span>@t?.Title</span> }</div>
        }
      </div>
    }
    else if (Model.Kind == "expert")
    {
      <div class="grid cols-b" style="margin-top:34px">
        @foreach (var a in Model.Items)
        {
          var t = a.For(L); var img = t.FirstImage();
          <a class="cell" href="/news/item/@a.Id?lang=@L" style="display:flex;flex-direction:column;color:inherit">
            <span class="@(img is null ? "hatch" : "")" style="height:210px;border-bottom:1px solid var(--line);display:block;
                  @(img is null ? "" : $"background:url('{img}') center top/cover no-repeat")"></span>
            <span style="padding:20px 22px 24px;display:flex;flex-direction:column;gap:7px;flex:1">
              <h3 style="font-family:var(--serif);font-size:17px;font-weight:700;color:var(--ink2)">@t?.Title</h3>
            </span>
          </a>
        }
      </div>
    }
    else
    {
      <div class="grid cols-b">
        @foreach (var a in Model.Items)
        {
          var t = a.For(L); var img = t.FirstImage();
          <a class="cell" href="/news/item/@a.Id?lang=@L" style="display:flex;flex-direction:column;color:inherit">
            <span class="@(img is null ? "hatch" : "")" style="height:170px;border-bottom:1px solid var(--line);display:block;
                  @(img is null ? "" : $"background:url('{img}') center/cover no-repeat")"></span>
            <span style="padding:22px 24px 26px;display:flex;flex-direction:column;gap:9px;flex:1">
              <span class="meta">@(a.PublishedAt?.ToString("yyyy-MM-dd") ?? "")</span>
              <h3 style="font-family:var(--serif);font-size:16.5px;font-weight:700;line-height:1.6;color:var(--ink2)">
                @(string.IsNullOrWhiteSpace(t?.Title) ? Ui.T(L,"untitled") : t!.Title)</h3>
            </span>
          </a>
        }
      </div>

      @if (Model.Pages > 1)
      {
        <div style="display:flex;gap:8px;width:fit-content;margin:44px auto 0">
          @for (var p = 1; p <= Model.Pages; p++)
          {
            <a class="cell" href="/c/@Model.Cat.Key/@(Model.Sub?.Key)?lang=@L&page=@p"
               style="padding:10px 17px;font-family:var(--mono);font-size:13px;
               @(p == Model.Page1 ? "background:var(--brand);color:#fff" : "color:var(--muted2)")">@p</a>
          }
        </div>
      }
    }
  }
  else
  {
    <div class="empty">@Ui.T(L,"nothingPublished")</div>
  }
</section>
