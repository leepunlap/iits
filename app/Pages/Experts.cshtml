@page "/experts"
@using IitsNews.Data
@model IitsNews.Pages.ExpertsModel
@{ var L = Model.CurrentLang; }

<section class="sec">
  <div class="crumb"><a href="/?lang=@L">@Ui.T(L,"home")</a> / @Ui.T(L,"experts")</div>
  <div class="sechead">
    <div>
      <div class="eyebrow">EXPERTS</div>
      <h2 class="h2">@Ui.T(L,"experts")</h2>
    </div>
    <p class="lede">@Ui.T(L,"expertsLede")</p>
  </div>

  @if (Model.Items.Count == 0)
  {
    <div class="empty">@Ui.T(L,"nothingPublished")</div>
  }
  else
  {
    <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr))">
      @foreach (var a in Model.Items)
      {
        var t = a.For(L); var img = t.FirstImage();
        <a class="cell" href="/news/item/@a.Id?lang=@L" style="display:flex;flex-direction:column;color:inherit">
          <span class="@(img is null ? "hatch" : "")" style="aspect-ratio:1/1;display:block;
                border-bottom:1px solid var(--line);
                @(img is null ? "" : $"background:url('{img}') center 22%/cover no-repeat")"></span>
          <span style="padding:20px 22px 24px;display:flex;flex-direction:column;gap:8px;flex:1">
            <h3 style="font-family:var(--serif);font-size:19px;font-weight:700;color:var(--ink2);line-height:1.4">@t?.Title</h3>
            @if (!string.IsNullOrWhiteSpace(t?.Keywords))
            {
              <span style="font-size:13.5px;line-height:1.75;color:var(--muted2)">@t!.Keywords</span>
            }
          </span>
        </a>
      }
    </div>
  }
</section>
