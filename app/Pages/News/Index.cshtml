@page "/news/{lang?}"
@model IitsNews.Pages.News.IndexModel

@if (Model.ShowDrafts)
{
    <div class="notice">
        <strong>草稿可見模式 · Draft preview mode.</strong>
        <p class="muted">
            Unpublished articles are listed below so the migrated content can be reviewed.
            This is a staging-only setting — <code>ShowDrafts</code> must be false in production.
        </p>
    </div>
}

<p class="langs">
    @foreach (var l in IitsNews.Data.Lang.All)
    {
        <a href="/news/@l" aria-current="@(l == Model.CurrentLang ? "true" : "false")">@IitsNews.Data.Lang.Label(l)</a>
    }
</p>

@if (Model.Items.Count == 0)
{
    <div class="notice">
        <strong>沒有文章。</strong>
        <p class="muted">Imported articles land as drafts. Publish them from the admin pages, or enable draft preview on staging.</p>
    </div>
}
else
{
    <p class="muted">@Model.Items.Count 篇</p>
    <table>
        <thead>
            <tr><th>日期</th><th>標題</th><th>欄目</th><th>狀態</th></tr>
        </thead>
        <tbody>
        @foreach (var a in Model.Items)
        {
            var t = a.For(Model.CurrentLang);
            <tr>
                <td class="muted">@(a.PublishedAt?.ToString("yyyy-MM-dd") ?? "—")</td>
                <td>
                    <a href="/news/item/@a.Id?lang=@Model.CurrentLang">@(t?.Title ?? "—")</a>
                    @if (a.Pinned) { <span class="pill">置頂</span> }
                    @if (t is not null && t.Lang != Model.CurrentLang)
                    {
                        <span class="pill">@IitsNews.Data.Lang.Label(t.Lang)</span>
                    }
                </td>
                <td class="muted">@a.Section</td>
                <td>
                    @if (a.Status == "published")
                    {
                        <span class="pill">已發布</span>
                    }
                    else
                    {
                        <span class="pill">草稿</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
