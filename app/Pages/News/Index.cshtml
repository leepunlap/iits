@page "/news/"
@using IitsNews.Data
@model IitsNews.Pages.News.IndexModel

<div class="crumb"><a href="/">首頁</a> · 最新消息</div>
<div class="eyebrow">NEWS</div>
<h1 style="font-size:clamp(30px,4.6vw,46px);margin-top:10px">最新消息</h1>
<p class="lede">全部已發布內容，共 @Model.Items.Count 篇。</p>

<p class="langs" style="margin-top:22px;display:flex;gap:9px">
    @foreach (var l in IitsNews.Data.Lang.All)
    {
        <a class="tag" style="padding:7px 15px;font-size:13px;@(l == Model.CurrentLang ? "border-color:var(--brand);color:var(--brand)" : "")"
           href="/news/?lang=@l">@IitsNews.Data.Lang.Label(l)</a>
    }
</p>

@if (Model.Items.Count == 0)
{
    <div class="empty">尚無已發布的內容。</div>
}
else
{
    <div class="grid">
        @foreach (var a in Model.Items)
        {
            var t = a.For(Model.CurrentLang); var img = t.FirstImage();
            <a class="card" href="/news/item/@a.Id?lang=@Model.CurrentLang">
                @if (img is not null) { <span class="thumb" style="background-image:url('@img')"></span> }
                <span class="body">
                    <h3>@(string.IsNullOrWhiteSpace(t?.Title) ? "（無標題）" : t!.Title)</h3>
                    <span style="font-size:14px;color:var(--muted)">@t.Excerpt()</span>
                    <span class="meta">
                        <span>@(a.PublishedAt?.ToString("yyyy-MM-dd") ?? "")</span>
                        @if (!string.IsNullOrEmpty(a.Section)) { <span>@a.Section</span> }
                    </span>
                </span>
            </a>
        }
    </div>
}
