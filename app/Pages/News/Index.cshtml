@page "/news/"
@using IitsNews.Data
@model IitsNews.Pages.News.IndexModel
@{ var L = Model.CurrentLang; }

<section class="sec">
  <div class="crumb"><a href="/?lang=@L">@Ui.T(L,"home")</a> / @Ui.T(L,"news")</div>
  <div class="sechead">
    <div>
      <div class="eyebrow">NEWS</div>
      <h2 class="h2">@Ui.T(L,"news")</h2>
    </div>
    <p class="lede">@Ui.T(L,"allNews") · @Model.Items.Count</p>
  </div>

  @if (Model.Items.Count == 0)
  {
    <div class="empty">@Ui.T(L,"nothingPublished")</div>
  }
  else
  {
    <div class="grid cols-b">
      @foreach (var a in Model.Items)
      {
        var t = a.For(L); var img = t.FirstImage();
        <a class="cell" href="/news/item/@a.Id?lang=@L" style="display:flex;flex-direction:column;color:inherit">
          <span class="@(img is null ? "hatch" : "")" style="height:180px;border-bottom:1px solid var(--line);display:block;
                @(img is null ? "" : $"background:url('{img}') center/cover no-repeat")"></span>
          <span style="padding:24px 26px 28px;display:flex;flex-direction:column;gap:10px;flex:1">
            <span class="meta">@(a.PublishedAt?.ToString("yyyy-MM-dd") ?? "")@(string.IsNullOrEmpty(a.Section) ? "" : "  ·  " + Ui.Section(L, a.Section))</span>
            <h3 style="font-family:var(--serif);font-size:17px;font-weight:700;line-height:1.6;color:var(--ink2)">
              @(string.IsNullOrWhiteSpace(t?.Title) ? Ui.T(L,"untitled") : t!.Title)</h3>
            <span style="font-size:14px;color:var(--muted2);line-height:1.8">@t.Excerpt()</span>
          </span>
        </a>
      }
    </div>
  }
</section>
