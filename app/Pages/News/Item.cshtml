@page "/news/item/{id:int}"
@using IitsNews.Data
@model IitsNews.Pages.News.ItemModel

@if (Model.Item is null || Model.Text is null)
{
    <div class="empty">@Ui.T(Model.CurrentLang,"notFound")</div>
}
else
{
    <div class="crumb">
        <a href="/?lang=@Model.CurrentLang">@Ui.T(Model.CurrentLang,"home")</a> · <a href="/news/?lang=@Model.CurrentLang">@Ui.T(Model.CurrentLang,"latest")</a>
        @if (!string.IsNullOrEmpty(Model.Item.Section)) { <text> · </text>@Ui.Section(Model.CurrentLang, Model.Item.Section) }
    </div>

    <article style="max-width:78ch">
        <h1 style="font-size:clamp(26px,3.8vw,40px);margin-bottom:16px">@Model.Text.Title</h1>
        <div class="meta" style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--soft);
                                 display:flex;gap:14px;flex-wrap:wrap;padding-bottom:22px;
                                 border-bottom:1px solid var(--line)">
            <span>@(Model.Item.PublishedAt?.ToString("yyyy-MM-dd") ?? "")</span>
            @if (!string.IsNullOrEmpty(Model.Item.Section)) { <span>@Ui.Section(Model.CurrentLang, Model.Item.Section)</span> }
            <span>@IitsNews.Data.Lang.Label(Model.Text.Lang)</span>
        </div>

        <div style="display:flex;gap:9px;flex-wrap:wrap;margin:20px 0 6px">
            @foreach (var l in IitsNews.Data.Lang.All)
            {
                var has = Model.Item.Translations.Any(x => x.Lang == l);
                if (has)
                {
                    <a class="tag" style="padding:6px 14px;@(l == Model.Text.Lang ? "border-color:var(--brand);color:var(--brand)" : "")"
                       href="/news/item/@Model.Item.Id?lang=@l">@IitsNews.Data.Lang.Label(l)</a>
                }
                else { <span class="tag" style="padding:6px 14px;opacity:.45">@IitsNews.Data.Lang.Label(l) —</span> }
            }
        </div>

        @if (Model.Text.Lang != Model.CurrentLang)
        {
            <div style="margin:18px 0;padding:13px 17px;border-radius:13px;background:rgba(61,86,153,.07);
                        font-size:14px;color:var(--muted)">
                此文章尚無 @IitsNews.Data.Lang.Label(Model.CurrentLang) 版本，以下為 @IitsNews.Data.Lang.Label(Model.Text.Lang) 內容。
            </div>
        }
        @if (Model.Text.Provenance == "machine")
        {
            <div style="margin:18px 0;padding:13px 17px;border-radius:13px;background:#fff6e5;
                        border:1px solid #f0dcb4;font-size:14px;color:#7a5b17">
                機器翻譯，未經審閱。 Machine translation, not yet reviewed.
            </div>
        }

        <div class="prose">@Html.Raw(Model.Text.BodyHtml)</div>
    </article>

    <style>
      .prose{margin-top:26px;font-size:16.5px;line-height:1.85;color:#1d2630;overflow-wrap:anywhere}
      .prose img{max-width:100%!important;height:auto!important;border-radius:14px;display:block;margin:20px auto}
      .prose p{margin:0 0 1.05em}
      .prose section{max-width:100%!important}
      .prose table{width:100%!important;border-collapse:collapse;display:block;overflow-x:auto}
      .prose td,.prose th{border:1px solid var(--line);padding:8px 10px}
      .prose a{color:var(--brand);text-decoration:underline}
      .prose h1,.prose h2,.prose h3{margin:1.5em 0 .5em}
      .prose iframe,.prose video{max-width:100%}
    </style>
}
