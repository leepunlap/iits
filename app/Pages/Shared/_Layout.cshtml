@using IitsNews.Services
@inject SiteMenu Menu
@{
    var menu = await Menu.GetAsync();
    var lang = ViewData["Lang"] as string ?? "zh-Hant";
    var isAdmin = ViewData["IsAdmin"] as bool? ?? false;
}
<!DOCTYPE html>
<html lang="@lang">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@ViewData["Title"] · 工信學堂（香港）· IITS</title>
<meta name="description" content="工信學堂（香港）IITS —— 工信部青少年信息技術培訓項目國際窗口。">
<meta property="og:type" content="website">
<meta property="og:site_name" content="工信學堂（香港）· IITS">
<meta property="og:title" content="@ViewData["Title"] · 工信學堂（香港）· IITS">
<meta property="og:image" content="/assets/og-cover.jpg">
<meta property="og:locale" content="zh_HK">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Noto+Sans+TC:wght@300;400;500;700;900&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box}
  :root{--ink:#10161d;--muted:#5b6673;--soft:#8792a3;--line:rgba(16,22,29,0.07);
        --bg:#f7f6f2;--card:#fff;--brand:#3d5699;--brand-d:#2f4275;--navy:#0d1b3a;--navy-t:#b9c4d8}
  html{-webkit-text-size-adjust:100%}
  body{margin:0;background:var(--bg);color:var(--ink);line-height:1.7;
       font-family:'Noto Sans TC','Space Grotesk',-apple-system,BlinkMacSystemFont,"PingFang HK","Microsoft JhengHei",sans-serif;
       font-weight:400}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:1280px;margin:0 auto;padding:0 40px}
  h1,h2,h3{font-family:'Space Grotesk','Noto Sans TC',sans-serif;letter-spacing:-.01em;line-height:1.25;margin:0}
  .eyebrow{font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.18em;
           text-transform:uppercase;color:var(--brand);font-weight:500}

  /* ---- nav: same shell as the hand-written IITS pages ---- */
  nav.top{position:sticky;top:0;z-index:50;padding:16px 40px;background:rgba(247,246,242,.7);
          backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}
  .navrow{max-width:1280px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:16px}
  .navlinks{display:flex;align-items:center;gap:4px;font-size:14.5px;font-weight:500}
  .navlinks>.item{position:relative}
  .navlinks>.item>a{display:block;padding:8px 13px;border-radius:999px;white-space:nowrap;transition:background .15s}
  .navlinks>.item>a:hover{background:rgba(16,22,29,.05)}
  .drop{position:absolute;top:calc(100% + 6px);left:0;min-width:210px;background:#fff;
        border:1px solid var(--line);border-radius:16px;padding:8px;opacity:0;visibility:hidden;
        transform:translateY(-6px);transition:.18s;box-shadow:0 22px 48px -26px rgba(16,22,29,.4)}
  .item:hover .drop{opacity:1;visibility:visible;transform:none}
  .drop a{display:flex;justify-content:space-between;gap:14px;padding:8px 12px;border-radius:10px;
          font-size:14px;color:var(--muted)}
  .drop a:hover{background:rgba(61,86,153,.07);color:var(--ink)}
  .drop .n{font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:var(--soft)}
  .cta{margin-left:8px;display:inline-flex;align-items:center;padding:10px 20px;background:var(--navy);
       color:#fff;border-radius:999px;font-size:13.5px;transition:background .15s}
  .cta:hover{background:var(--brand)}
  .cta2{display:inline-flex;align-items:center;padding:9px 18px;border:1px solid rgba(16,22,29,.18);
        border-radius:999px;font-size:13.5px;transition:border-color .15s}
  .cta2:hover{border-color:var(--ink)}
  .navtoggle{display:none;background:none;border:0;cursor:pointer;padding:9px;width:44px;height:44px;
             flex-direction:column;justify-content:center;gap:5px}
  .navtoggle span{display:block;height:2px;width:22px;background:var(--ink);border-radius:2px;transition:.25s}
  .navtoggle.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
  .navtoggle.open span:nth-child(2){opacity:0}
  .navtoggle.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
  .navpanel{display:none;max-width:1280px;margin:12px auto 0}
  .navpanel a{display:block;padding:11px 14px;border-radius:12px;font-size:15px}
  .navpanel a:hover{background:rgba(16,22,29,.05)}
  .navpanel .sub{padding-left:28px;font-size:14px;color:var(--muted)}
  @@media(max-width:1040px){
    .navlinks{display:none}
    .navtoggle{display:flex}
    .navpanel.open{display:block}
    .wrap,nav.top{padding-left:22px;padding-right:22px}
  }

  /* ---- shared page furniture ---- */
  .page{padding:56px 0 96px}
  .lede{color:var(--muted);font-size:16.5px;max-width:60ch;margin:14px 0 0}
  .crumb{font-size:13.5px;color:var(--soft);margin-bottom:14px}
  .crumb a:hover{color:var(--brand)}
  .grid{display:grid;gap:22px;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));margin-top:38px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:22px;overflow:hidden;
        display:flex;flex-direction:column;transition:transform .3s,box-shadow .3s}
  .card:hover{transform:translateY(-3px);box-shadow:0 26px 54px -30px rgba(16,22,29,.42)}
  .card .thumb{aspect-ratio:16/9;background:#eceae4 center/cover no-repeat;display:block}
  .card .body{padding:20px 22px 22px;display:flex;flex-direction:column;gap:9px;flex:1}
  .card h3{font-size:17px;font-weight:600;line-height:1.45}
  .card .meta{font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:var(--soft);
              letter-spacing:.04em;display:flex;gap:10px;flex-wrap:wrap;margin-top:auto}
  .tag{display:inline-block;padding:3px 10px;border:1px solid var(--line);border-radius:999px;
       font-size:11.5px;color:var(--muted);font-family:'IBM Plex Mono',monospace}
  .empty{padding:70px 0;text-align:center;color:var(--soft)}

  footer.site{background:var(--navy);color:var(--navy-t);padding:72px 40px 40px;margin-top:80px}
  footer.site .cols{max-width:1280px;margin:0 auto;display:grid;gap:36px;
                    grid-template-columns:repeat(auto-fit,minmax(210px,1fr))}
  footer.site h4{font-family:'Space Grotesk',sans-serif;color:#fff;font-size:14px;margin:0 0 14px;
                 letter-spacing:.04em}
  footer.site a{display:block;padding:4px 0;font-size:14px;color:var(--navy-t)}
  footer.site a:hover{color:#fff}
  footer.site .base{max-width:1280px;margin:44px auto 0;padding-top:22px;
                    border-top:1px solid rgba(255,255,255,.1);font-size:12.5px;color:#8f9bb0;
                    display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
  .stagetag{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.1em;
            padding:3px 9px;border:1px solid rgba(255,255,255,.18);border-radius:999px}
</style>
</head>
<body>

<nav class="top">
  <div class="navrow">
    <a href="/" aria-label="工信學堂 IITS">
      <img src="/assets/iits-logo.webp" alt="工信學堂（香港）· IITS" style="height:38px;width:auto;display:block">
    </a>
    <div class="navlinks">
      @foreach (var m in menu)
      {
        <div class="item">
          <a href="/s/@m.LegacyId">@m.Name</a>
          @if (m.Children.Count > 0)
          {
            <div class="drop">
              @foreach (var c in m.Children)
              {
                <a href="/s/@c.LegacyId"><span>@c.Name</span><span class="n">@c.ArticleCount</span></a>
              }
            </div>
          }
        </div>
      }
      <div class="item"><a href="/news/">最新消息</a></div>
      <a class="cta2" href="https://iits.giftedintl.com/student/">學生專區</a>
      <a class="cta" href="https://iits.giftedintl.com/teacher/">教師專區</a>
    </div>
    <button class="navtoggle" id="navToggle" aria-label="選單" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="navpanel" id="navPanel">
    @foreach (var m in menu)
    {
      <a href="/s/@m.LegacyId">@m.Name</a>
      foreach (var c in m.Children) { <a class="sub" href="/s/@c.LegacyId">@c.Name</a> }
    }
    <a href="/news/">最新消息</a>
    <a href="https://iits.giftedintl.com/student/">學生專區</a>
    <a href="https://iits.giftedintl.com/teacher/">教師專區</a>
  </div>
</nav>

<main class="wrap page">
  @RenderBody()
</main>

<footer class="site">
  <div class="cols">
    <div>
      <h4>工信學堂（香港）</h4>
      <div style="font-size:13.5px;line-height:1.8;color:#8f9bb0">
        Industry and Information Technology Class<br>
        工信部青少年信息技術培訓項目國際窗口
      </div>
    </div>
    @foreach (var m in menu.Take(3))
    {
      <div>
        <h4>@m.Name</h4>
        @foreach (var c in m.Children.Take(6)) { <a href="/s/@c.LegacyId">@c.Name</a> }
      </div>
    }
    <div>
      <h4>專區</h4>
      <a href="/news/">最新消息</a>
      <a href="https://iits.giftedintl.com/">主網站</a>
      <a href="https://iits.giftedintl.com/student/">學生專區</a>
      <a href="https://iits.giftedintl.com/teacher/">教師專區</a>
      @if (isAdmin) { <a href="/admin/">內容管理</a> }
    </div>
  </div>
  <div class="base">
    <span>© @DateTime.Now.Year 工信學堂（香港）· IITS</span>
    <span class="stagetag">STAGING · 合併預覽</span>
  </div>
</footer>

<script>
  var t=document.getElementById('navToggle'), p=document.getElementById('navPanel');
  if(t){t.addEventListener('click',function(){
    var o=p.classList.toggle('open'); t.classList.toggle('open',o); t.setAttribute('aria-expanded',o);
  });}
</script>
</body>
</html>
