@using IitsNews.Services
@inject SiteMenu Menu
@{
    var menu = await Menu.GetAsync();
    var lang = ViewData["Lang"] as string ?? "zh-Hant";
    var isAdmin = ViewData["IsAdmin"] as bool? ?? false;
    // The design ships a TC artboard and an SC artboard with different Noto families.
    // Follow it: Traditional gets Noto Serif/Sans TC, Simplified gets SC, English falls
    // back to the system stack rather than forcing a CJK face on Latin text.
    var serif = lang == "zh-Hans" ? "'Noto Serif SC',serif" : "'Noto Serif TC',serif";
    var sans  = lang == "zh-Hans" ? "'Noto Sans SC',system-ui,sans-serif" : "'Noto Sans TC',system-ui,sans-serif";
    var gf    = lang == "zh-Hans"
        ? "https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@500;700;900&family=Noto+Sans+SC:wght@300;400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
        : "https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@500;700;900&family=Noto+Sans+TC:wght@300;400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap";
    var path = Context.Request.Path.HasValue ? Context.Request.Path.Value! : "/";
    string LangHref(string l)
    {
        var q = Context.Request.Query.Where(kv => kv.Key != "lang")
            .Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value!)}").Append($"lang={l}");
        return path + "?" + string.Join("&", q);
    }
}
<!DOCTYPE html>
<html lang="@lang">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@ViewData["Title"] · @Ui.T(lang,"siteName")</title>
<meta name="description" content="@Ui.T(lang,"tagline")">
<meta property="og:type" content="website">
<meta property="og:site_name" content="@Ui.T(lang,"siteName")">
<meta property="og:title" content="@ViewData["Title"]">
<meta property="og:image" content="/assets/og-cover.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="@gf" rel="stylesheet">
<style>
  *{box-sizing:border-box}
  :root{
    --bg:#FAFAFC; --panel:#F1F3F9; --panel2:#F2F4FA; --foot:#EEF0F6; --card:#FFFFFF;
    --ink:#12171D; --ink2:#1B222A; --body:#2B3239;
    --muted:#585F69; --muted2:#5F666F; --muted3:#454C56; --faint:#949AA2; --faint2:#6F767E;
    --brand:#46599C; --brand-d:#2F3F78;
    --line:rgba(28,34,41,0.07); --line2:rgba(28,34,41,0.09); --line3:rgba(28,34,41,0.12);
    --brandline:rgba(70,89,156,0.18);
    --hatch:repeating-linear-gradient(135deg,#E6E9F1 0 8px,#F3F5FA 8px 16px);
    --serif:@serif; --sans:@sans; --mono:'IBM Plex Mono',monospace;
  }
  html{-webkit-text-size-adjust:100%}
  body{margin:0;background:var(--bg);color:var(--body);font-family:var(--sans);
       font-weight:300;-webkit-font-smoothing:antialiased;line-height:1.8}
  a{color:var(--brand);text-decoration:none}
  a:hover{color:var(--brand-d)}
  h1,h2,h3{font-family:var(--serif);margin:0;color:var(--ink)}
  img{max-width:100%}

  .shell{max-width:1320px;margin:0 auto;padding:0 clamp(16px,3vw,40px)}
  .sec{max-width:1320px;margin:0 auto;padding:clamp(52px,7vw,96px) clamp(16px,3vw,40px)}
  .eyebrow{font-family:var(--mono);font-size:11.5px;letter-spacing:.2em;color:var(--brand);margin-bottom:16px}
  .h2{font-family:var(--serif);font-weight:700;font-size:clamp(25px,3.2vw,38px);line-height:1.3;color:var(--ink)}
  .sechead{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:40px;margin-bottom:48px}
  .lede{font-size:15px;line-height:1.9;color:var(--muted2);max-width:420px;margin:0;font-weight:300}
  .more{font-size:13.5px;letter-spacing:.05em;white-space:nowrap}
  .hatch{background-image:var(--hatch)}

  /* the design's signature: a hairline GRID, cells separated by 1px of the border colour */
  .grid{display:grid;gap:1px;background:var(--line2);border:1px solid var(--line2)}
  .grid.cols-a{grid-template-columns:repeat(auto-fit,minmax(210px,1fr))}
  .grid.cols-b{grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}
  .cell{background:var(--card);transition:background .15s}
  .cell:hover{background:var(--panel2)}

  .utility{background:var(--panel);border-bottom:1px solid var(--brandline)}
  .utility .shell{min-height:38px;display:flex;flex-wrap:wrap;align-items:center;
                  justify-content:space-between;gap:10px;font-size:12px;letter-spacing:.06em;color:var(--muted2)}
  .utility .org{font-family:var(--mono)}
  .util-right{display:flex;gap:20px;align-items:center;flex-wrap:wrap}
  .langsel{display:flex;align-items:center;border:1px solid var(--line3);font-family:var(--mono);letter-spacing:.06em}
  .langsel a{padding:3px 9px;font-size:11.5px;color:var(--muted2)}
  .langsel a+a{border-left:1px solid var(--line3)}
  .langsel a:hover{color:var(--brand)}
  .langsel a.on{background:var(--brand);color:#fff}
  .langsel a.on:hover{color:#fff}
  .vr{width:1px;height:14px;background:var(--line3)}

  header.site{position:sticky;top:0;z-index:40;background:rgba(250,250,252,.94);
              backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
  header.site .shell{padding-top:10px;padding-bottom:10px;min-height:76px;display:flex;flex-wrap:wrap;
                     align-items:center;justify-content:space-between;gap:clamp(16px,2.2vw,36px)}
  header.site img{height:30px;width:auto;display:block;flex-shrink:0}
  nav.main{display:flex;flex:1 1 340px;justify-content:flex-end;flex-wrap:wrap;align-items:center;
           gap:clamp(10px,1.5vw,22px);font-size:clamp(12px,1.05vw,14px);color:var(--muted3);font-weight:400}
  nav.main a{color:var(--muted3)} nav.main a:hover{color:var(--brand)}
  nav.main a.on{color:var(--ink2);padding-bottom:3px;border-bottom:2px solid var(--brand)}

  .btn{background:var(--brand);color:#fff;font-size:14.5px;font-weight:500;padding:14px 28px;
       letter-spacing:.03em;white-space:nowrap;display:inline-block}
  .btn:hover{background:var(--brand-d);color:#fff}
  .btn2{border:1px solid rgba(28,34,41,.22);color:var(--body);font-size:14.5px;padding:14px 28px;
        letter-spacing:.03em;white-space:nowrap;display:inline-block}
  .btn2:hover{border-color:var(--brand);color:var(--brand)}

  .meta{font-family:var(--mono);font-size:11px;color:var(--faint);letter-spacing:.04em}
  .crumb{font-family:var(--mono);font-size:11.5px;letter-spacing:.08em;color:var(--faint2);margin-bottom:18px}
  .empty{padding:70px 0;text-align:center;color:var(--faint2)}

  footer.site{background:var(--foot);border-top:1px solid var(--brandline);margin-top:0}
  footer.site .cols{max-width:1320px;margin:0 auto;padding:clamp(48px,6vw,72px) clamp(16px,3vw,40px) 0;
                    display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:56px}
  footer.site .ftitle{font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;color:var(--brand);margin-bottom:20px}
  footer.site .stack{display:flex;flex-direction:column;gap:12px;font-size:14px}
  footer.site .stack a{color:var(--muted)} footer.site .stack a:hover{color:var(--brand)}
  footer.site .addr{display:flex;flex-direction:column;gap:10px;font-size:13.5px;line-height:1.8;
                    color:var(--muted2);font-weight:300}
  footer.site .base{max-width:1320px;margin:0 auto;padding:36px clamp(16px,3vw,40px);
                    border-top:1px solid var(--line);margin-top:56px;display:flex;justify-content:space-between;
                    gap:16px;flex-wrap:wrap;font-family:var(--mono);font-size:11px;color:var(--faint)}

  #side-rail{position:fixed;right:0;top:50%;transform:translateY(-50%);z-index:30;
             display:flex;flex-direction:column;background:var(--card);border:1px solid var(--line2)}
  #side-rail a{writing-mode:vertical-rl;padding:14px 9px;font-size:12px;color:var(--muted2);letter-spacing:.1em}
  #side-rail a+a{border-top:1px solid var(--line2)}
  #side-rail a:hover{background:var(--panel2);color:var(--brand)}
  @@media(max-width:1120px){#side-rail{display:none}}

  .navtoggle{display:none;background:none;border:0;cursor:pointer;padding:9px;width:44px;height:44px;
             flex-direction:column;justify-content:center;gap:5px}
  .navtoggle span{display:block;height:2px;width:22px;background:var(--ink2);transition:.25s}
  .navtoggle.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
  .navtoggle.open span:nth-child(2){opacity:0}
  .navtoggle.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
  .navpanel{display:none;width:100%;padding-bottom:12px}
  .navpanel a{display:block;padding:10px 2px;font-size:15px;color:var(--muted3);border-bottom:1px solid var(--line)}
  @@media(max-width:1060px){
    nav.main{display:none}
    .navtoggle{display:flex}
    .navpanel.open{display:block}
  }
</style>
</head>
<body>

<div class="utility">
  <div class="shell">
    <span class="org">@Ui.T(lang,"orgLine")</span>
    <div class="util-right">
      <div class="langsel">
        @foreach (var l in IitsNews.Data.Lang.All)
        {
          <a href="@LangHref(l)" class="@(l == lang ? "on" : "")" hreflang="@l">@IitsNews.Data.Lang.Short(l)</a>
        }
      </div>
      <span class="vr"></span>
      <a href="https://iits.giftedintl.com/student/" style="color:var(--muted2)">@Ui.T(lang,"student")</a>
      <a href="https://iits.giftedintl.com/teacher/" style="letter-spacing:.08em">@Ui.T(lang,"teacher") →</a>
    </div>
  </div>
</div>

<header class="site">
  <div class="shell">
    <a href="/?lang=@lang" aria-label="@Ui.T(lang,"siteName")">
      <img src="/assets/iits-logo.png" alt="@Ui.T(lang,"siteName")">
    </a>
    <nav class="main">
      <a href="/?lang=@lang" class="@(path == "/" ? "on" : "")">@Ui.T(lang,"home")</a>
      @foreach (var m in menu)
      {
        <a href="/s/@m.LegacyId?lang=@lang" class="@(path == $"/s/{m.LegacyId}" ? "on" : "")">@Ui.Section(lang, m.Name)</a>
      }
      <a href="/news/?lang=@lang" class="@(path.StartsWith("/news") ? "on" : "")">@Ui.T(lang,"latest")</a>
    </nav>
    <button class="navtoggle" id="navToggle" aria-label="menu" aria-expanded="false"><span></span><span></span><span></span></button>
    <div class="navpanel" id="navPanel">
      <a href="/?lang=@lang">@Ui.T(lang,"home")</a>
      @foreach (var m in menu) { <a href="/s/@m.LegacyId?lang=@lang">@Ui.Section(lang, m.Name)</a> }
      <a href="/news/?lang=@lang">@Ui.T(lang,"latest")</a>
    </div>
  </div>
</header>

@RenderBody()

<footer class="site">
  <div class="cols">
    <div>
      <img src="/assets/iits-logo.png" alt="" style="height:34px;width:auto;display:block;margin-bottom:24px">
      <div class="addr">
        <span>@Ui.T(lang,"ftWeb")</span>
        <span>@Ui.T(lang,"ftTel")</span>
        <span>@Ui.T(lang,"ftMail")</span>
        <span>@Ui.T(lang,"ftHours")</span>
        <span>@Ui.T(lang,"ftAddr")</span>
        <span style="color:var(--faint2)">Room 24, 3/F, Building 2W, 2 Science Park West Avenue, Hong Kong Science Park</span>
      </div>
    </div>
    @foreach (var m in menu.Take(2))
    {
      <div>
        <div class="ftitle">@Ui.Section(lang, m.Name)</div>
        <div class="stack">
          @foreach (var c in m.Children.Take(6)) { <a href="/s/@c.LegacyId?lang=@lang">@Ui.Section(lang, c.Name)</a> }
        </div>
      </div>
    }
    <div>
      <div class="ftitle">@Ui.T(lang,"sitemap")</div>
      <div class="stack">
        <a href="/news/?lang=@lang">@Ui.T(lang,"latest")</a>
        <a href="https://iits.giftedintl.com/">@Ui.T(lang,"mainSite")</a>
        <a href="https://iits.giftedintl.com/student/">@Ui.T(lang,"student")</a>
        <a href="https://iits.giftedintl.com/teacher/">@Ui.T(lang,"teacher")</a>
        @if (isAdmin) { <a href="/admin/">@Ui.T(lang,"admin")</a> }
      </div>
    </div>
  </div>
  <div class="base">
    <span>© @DateTime.Now.Year @Ui.T(lang,"siteName")</span>
    <span>@Ui.T(lang,"staging")</span>
  </div>
</footer>

<div id="side-rail">
  <a href="https://iits.giftedintl.com/student/">@Ui.T(lang,"student")</a>
  <a href="https://iits.giftedintl.com/teacher/">@Ui.T(lang,"teacher")</a>
</div>

<script>
  var t=document.getElementById('navToggle'), p=document.getElementById('navPanel');
  if(t){t.addEventListener('click',function(){var o=p.classList.toggle('open');
    t.classList.toggle('open',o); t.setAttribute('aria-expanded',o);});}
</script>
</body>
</html>
