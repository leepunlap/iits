@using IitsNews.Services
@inject SiteMenu Menu
@{
    var menu = await Menu.GetAsync();
    var lang = ViewData["Lang"] as string ?? "zh-Hant";
    var isAdmin = ViewData["IsAdmin"] as bool? ?? false;
    // The design ships a TC artboard and an SC artboard with different Noto families.
    // Follow it: Traditional gets Noto Serif/Sans TC, Simplified gets SC, English falls
    // back to the system stack rather than forcing a CJK face on Latin text.
    // The live site sets headings in Space Grotesk with Noto Sans TC for CJK — not a serif.
    // Following it means adopting that, so the two sites read as one brand.
    var serif = lang == "zh-Hans" ? "'Space Grotesk','Noto Sans SC',sans-serif" : "'Space Grotesk','Noto Sans TC',sans-serif";
    var sans  = lang == "zh-Hans" ? "'Noto Sans SC',system-ui,sans-serif" : "'Noto Sans TC',system-ui,sans-serif";
    var gf    = lang == "zh-Hans"
        ? "https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;600;700&family=Noto+Sans+SC:wght@300;400;500;700;900&family=IBM+Plex+Mono:wght@400;500&display=swap"
        : "https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;600;700&family=Noto+Sans+TC:wght@300;400;500;700;900&family=IBM+Plex+Mono:wght@400;500&display=swap";
    var path = Context.Request.Path.HasValue ? Context.Request.Path.Value! : "/";
    string LangHref(string l)
    {
        var q = Context.Request.Query.Where(kv => kv.Key != "lang")
            .Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value!)}").Append($"lang={l}");
        return path + "?" + string.Join("&", q);
    }
}
<!DOCTYPE html>
<html lang="@lang">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@ViewData["Title"] · @Ui.T(lang,"siteName")</title>
<meta name="description" content="@Ui.T(lang,"tagline")">
<meta property="og:type" content="website">
<meta property="og:site_name" content="@Ui.T(lang,"siteName")">
<meta property="og:title" content="@ViewData["Title"]">
<meta property="og:image" content="/assets/og-cover.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="@gf" rel="stylesheet">
<style>
  *{box-sizing:border-box}
  :root{
    /* Palette taken verbatim from iits.giftedintl.com so the two sites are one brand.
       Replaces the design-artboard values (#46599C / #FAFAFC / Noto Serif) at the owner's
       instruction to follow the live site's CSS. */
    --bg:#f7f6f2; --panel:#f0eeea; --panel2:#faf9f6; --foot:#0d1b3a; --card:#ffffff;
    --ink:#10161d; --ink2:#10161d; --body:#10161d;
    --muted:#4c5765; --muted2:#5b6673; --muted3:#4c5765; --faint:#8792a3; --faint2:#7488a0;
    --brand:#3d5699; --brand-d:#2f4275;
    --line:rgba(16,22,29,0.07); --line2:rgba(16,22,29,0.10); --line3:rgba(16,22,29,0.14);
    --brandline:rgba(16,22,29,0.08);
    --navy:#0d1b3a; --navy-t:#b9c4d8;
    --hatch:linear-gradient(#f4f3ef,#eceae4);
    --serif:@serif; --sans:@sans; --mono:'IBM Plex Mono',monospace;
  }
  html{-webkit-text-size-adjust:100%}
  body{margin:0;background:var(--bg);color:var(--body);font-family:var(--sans);
       font-weight:400;-webkit-font-smoothing:antialiased;line-height:1.7;
       -webkit-text-size-adjust:100%}
  html{scroll-behavior:smooth}
  ::selection{background:var(--brand);color:#fff}
  a{color:var(--brand);text-decoration:none}
  a:hover{color:var(--brand-d)}
  h1,h2,h3{font-family:var(--serif);margin:0;color:var(--ink);font-weight:900;letter-spacing:-.5px}
  img{max-width:100%}

  .shell{max-width:1320px;margin:0 auto;padding:0 clamp(16px,3vw,40px)}
  /* ---- hero, lifted from the live iits.giftedintl.com ---- */
  .hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center}
  .hero-badge{display:inline-flex;align-items:center;gap:9px;padding:7px 15px 7px 9px;background:#fff;
              border:1px solid rgba(16,22,29,.1);border-radius:999px;font-family:var(--mono);
              font-size:11.5px;letter-spacing:.5px;color:#3A4657;margin-bottom:30px}
  .pill-cta{display:inline-flex;align-items:center;gap:10px;background:var(--brand);color:#fff;
            padding:16px 30px;border-radius:999px;font-size:15.5px;font-weight:500;white-space:nowrap}
  .pill-cta:hover{background:var(--brand-d);color:#fff}
  .pill-cta2{display:inline-flex;align-items:center;padding:16px 28px;border-radius:999px;
             border:1px solid rgba(16,22,29,.18);color:var(--ink);font-size:15.5px;font-weight:500;white-space:nowrap}
  .pill-cta2:hover{border-color:var(--ink)}
  .hero-art{position:relative;height:520px}
  .hero-art img{width:100%;height:100%;object-fit:cover;display:block}
  .hero-a{position:absolute;top:20px;right:0;width:78%;height:340px;border-radius:24px;overflow:hidden;
          box-shadow:0 40px 80px -30px rgba(16,22,29,.35)}
  .hero-b{position:absolute;bottom:30px;left:0;width:50%;height:230px;border-radius:20px;overflow:hidden;
          box-shadow:0 30px 60px -24px rgba(16,22,29,.35);border:5px solid var(--bg);
          animation:floaty 6s ease-in-out infinite}
  .hero-stat{position:absolute;top:0;left:8%;background:var(--navy);color:#fff;padding:16px 20px;
             border-radius:16px;box-shadow:0 20px 40px -16px rgba(16,22,29,.4);
             animation:floaty 5s ease-in-out infinite}
  @@keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
  @@media(max-width:900px){
    .hero-grid{grid-template-columns:1fr;gap:34px}
    .hero-art{height:330px}
  }
  @@media(prefers-reduced-motion:reduce){ .hero-b,.hero-stat{animation:none} }

  .sec{max-width:1320px;margin:0 auto;padding:clamp(52px,7vw,96px) clamp(16px,3vw,40px)}
  .eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:2.5px;color:var(--brand);margin-bottom:16px}
  .h2{font-family:var(--serif);font-weight:900;font-size:clamp(30px,4vw,52px);line-height:1.2;letter-spacing:-.5px;color:var(--ink)}
  .sechead{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:40px;margin-bottom:48px}
  .lede{font-size:15px;line-height:1.9;color:var(--muted2);max-width:420px;margin:0;font-weight:300}
  .more{font-size:13.5px;letter-spacing:.05em;white-space:nowrap}
  /* Flat placeholder for cards with no image. Was a diagonal hatch carried over from
     the design artboard, where it marked 'image goes here'; on a real page that reads as a
     broken texture, so it is now a quiet flat panel. */
  .hatch{background-image:var(--hatch);position:relative}
  .hatch::after{content:'';position:absolute;left:50%;top:50%;width:26px;height:26px;
                transform:translate(-50%,-50%);border:1.5px solid rgba(28,34,41,.13);border-radius:3px}

  /* the design's signature: a hairline GRID, cells separated by 1px of the border colour */
  .grid{display:grid;gap:20px;background:transparent;border:0}
  .grid.cols-a{grid-template-columns:repeat(auto-fit,minmax(210px,1fr))}
  .grid.cols-b{grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}
  .cell{background:var(--card);border:1px solid var(--line);border-radius:22px;overflow:hidden;
        transition:transform .3s,box-shadow .3s}
  .cell:hover{transform:translateY(-8px);box-shadow:0 30px 60px -28px rgba(16,22,29,.3)}

  .utility{background:var(--panel);border-bottom:1px solid var(--brandline)}
  .utility .shell{min-height:38px;display:flex;flex-wrap:wrap;align-items:center;
                  justify-content:space-between;gap:10px;font-size:12px;letter-spacing:.06em;color:var(--muted2)}
  .utility .org{font-family:var(--mono)}
  .util-right{display:flex;gap:20px;align-items:center;flex-wrap:wrap}
  .langsel{display:flex;align-items:center;border:1px solid var(--line3);font-family:var(--mono);letter-spacing:.06em}
  .langsel a{padding:3px 9px;font-size:11.5px;color:var(--muted2)}
  .langsel a+a{border-left:1px solid var(--line3)}
  .langsel a:hover{color:var(--brand)}
  .langsel a.on{background:var(--brand);color:#fff}
  .langsel a.on:hover{color:#fff}
  .vr{width:1px;height:14px;background:var(--line3)}

  header.site{position:sticky;top:0;z-index:40;background:rgba(250,250,252,.94);
              backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
  header.site .shell{padding-top:12px;padding-bottom:12px;min-height:92px;display:flex;flex-wrap:wrap;
                     align-items:center;justify-content:space-between;gap:clamp(16px,2.2vw,36px)}
  header.site img{height:clamp(38px,3.6vw,52px);width:auto;display:block;flex-shrink:0}
  nav.main{display:flex;flex:1 1 340px;justify-content:flex-end;flex-wrap:wrap;align-items:center;
           gap:clamp(10px,1.5vw,22px);font-size:clamp(12px,1.05vw,14px);color:var(--muted3);font-weight:400}
  nav.main a{color:var(--muted3)} nav.main a:hover{color:var(--brand)}
  nav.main a.on{color:var(--ink2);padding-bottom:3px;border-bottom:2px solid var(--brand)}
  /* Dropdowns. The design's nav was a flat row of links; with five categories carrying
     subcategories the children have to fold away, or the header runs to two lines and stops
     being navigation. Hover/focus-within reveals, so it works from the keyboard too. */
  nav.main>.item{position:relative}
  nav.main>.item>a{display:block;padding:8px 2px;white-space:nowrap}
  nav.main .drop{position:absolute;top:calc(100% + 10px);left:50%;transform:translate(-50%,-6px);
                 min-width:190px;background:#fff;border:1px solid var(--line2);padding:6px;
                 opacity:0;visibility:hidden;transition:.16s;z-index:60;
                 box-shadow:0 22px 46px -26px rgba(16,22,29,.42)}
  nav.main>.item:hover .drop,
  nav.main>.item:focus-within .drop{opacity:1;visibility:visible;transform:translate(-50%,0)}
  nav.main .drop a{display:block;padding:9px 14px;font-size:13.5px;color:var(--muted2);
                   white-space:nowrap;border-bottom:0}
  nav.main .drop a:hover{background:rgba(70,89,156,.07);color:var(--ink)}
  /* a hover bridge, so the pointer can cross the gap without the menu closing */
  nav.main>.item::after{content:'';position:absolute;left:0;right:0;top:100%;height:12px}

  .btn{background:var(--brand);color:#fff;font-size:14.5px;font-weight:500;padding:14px 28px;
       letter-spacing:.03em;white-space:nowrap;display:inline-block}
  .btn:hover{background:var(--brand-d);color:#fff}
  .btn2{border:1px solid rgba(28,34,41,.22);color:var(--body);font-size:14.5px;padding:14px 28px;
        letter-spacing:.03em;white-space:nowrap;display:inline-block}
  .btn2:hover{border-color:var(--brand);color:var(--brand)}

  /* ---- tumbling assessment cube, liquid glass, JS physics -------------------------
     The badge was never a hexagon: that outline is a cube in isometric projection.

     ORIENTATION IS SIMULATED, NOT KEYFRAMED. cube.js integrates a quaternion from an
     angular-velocity vector each frame, so the motion has real state: it can be nudged,
     it carries momentum, and it never repeats. Keyframes cannot express any of that.

     THE LABEL LIVES AT THE CUBE'S CENTRE, at translateZ(0) INSIDE the preserve-3d
     hierarchy, and is counter-rotated by the inverse quaternion so it always faces the
     viewer. Being a real plane at z=0 rather than an overlay is what lets the near faces
     pass IN FRONT of it — the letters are inside the glass, not painted on top.

     Letters are potrace vectors of the source art's own condensed gothic, so they stay
     crisp at any size instead of being an upscaled 23px bitmap.

     CSS 3D + a small rAF loop rather than three.js: ~600 KB and five WebGL contexts is not
     a price worth paying to tumble five logos. ------------------------------------------ */
  /* Twelve advisers on two rows of six. Fixed at 6 rather than auto-fill because the
     roster is a known, fixed set — an auto grid reflows it to 5+5+2, which reads as a
     ragged list instead of a panel. Steps down in even divisors so it never leaves an
     orphan on the last row. */
  .experts-grid{grid-template-columns:repeat(6,1fr)}
  @@media(max-width:1240px){ .experts-grid{grid-template-columns:repeat(4,1fr)} }
  @@media(max-width:820px) { .experts-grid{grid-template-columns:repeat(3,1fr)} }
  @@media(max-width:560px) { .experts-grid{grid-template-columns:repeat(2,1fr)} }
  .experts-grid h3{font-size:16px!important}
  .experts-grid .cell span:last-child{padding:16px 16px 20px!important}

  .cube-stage{position:relative;width:124px;height:124px;perspective:640px;
              display:flex;align-items:center;justify-content:center;isolation:isolate;
              cursor:grab;touch-action:none;-webkit-tap-highlight-color:transparent}
  .cube-stage:active{cursor:grabbing}
  .cube-stage::before{content:'';position:absolute;width:66px;height:66px;border-radius:50%;
    z-index:0;left:50%;top:50%;margin:-33px 0 0 -33px;pointer-events:none;
    background:radial-gradient(circle at 34% 30%,rgba(126,164,246,.55) 0%,
               rgba(178,203,255,.32) 45%,rgba(214,229,255,0) 74%);
    filter:blur(6px)}

  .cube{position:relative;z-index:1;width:62px;height:62px;transform-style:preserve-3d;
        will-change:transform}
  .cube i{position:absolute;inset:0;display:block;box-sizing:border-box;border-radius:0;
          background:linear-gradient(135deg,rgba(255,255,255,.42) 0%,rgba(255,255,255,.05) 42%,
                     rgba(150,182,250,.15) 66%,rgba(255,255,255,.26) 100%);
          border:1.5px solid rgba(70,118,224,.62);
          box-shadow:inset 0 1px 0 rgba(255,255,255,.8),
                     inset 0 -8px 14px -12px rgba(46,109,240,.4)}
  @@supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .cube i{background:linear-gradient(135deg,rgba(255,255,255,.30) 0%,rgba(255,255,255,.03) 44%,
                       rgba(255,255,255,.20) 100%);
            /* Blur has to stay LOW. The label sits at the cube's centre, so every near
               face blurs it — physically right, but at 4px the letters stopped being
               legible. 1.2px keeps the refraction reading as glass while the code stays
               sharp through it. */
            -webkit-backdrop-filter:blur(0.6px) saturate(135%);
            backdrop-filter:blur(0.6px) saturate(135%)}
  }
  .cube .f{transform:translateZ(31px)}
  .cube .b{transform:rotateY(180deg) translateZ(31px)}
  .cube .r{transform:rotateY(90deg)  translateZ(31px)}
  .cube .l{transform:rotateY(-90deg) translateZ(31px)}
  .cube .u{transform:rotateX(90deg)  translateZ(31px)}
  .cube .d{transform:rotateX(-90deg) translateZ(31px)}

  /* the plane at the centre of the cube, counter-rotated by JS */
  .cube .lbl{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
             pointer-events:none;will-change:transform}
  /* LIVE TEXT, not a traced bitmap. The source art is 23px tall, so potrace outlines of it
     came out lumpy at display size — there simply is not enough information in the original
     to vectorise cleanly. Anton is a heavy condensed grotesque and the closest widely
     available match to the face the badge used; as real text it is crisp at any size and
     costs nothing to render.
     The depth is stacked text-shadows stepping down-right, which reads as an extruded solid
     rather than a flat sticker. Genuine extrusion would be invisible here: the label is
     counter-rotated to face the viewer, so its sides never turn toward the camera. */
  /* Rendered at 2x and scaled down by the transform. Anything inside a 3D-transformed
     parent is rasterised ONCE at its layout size and then transformed, so 20px text drawn
     at 20px and pushed through a matrix comes out soft. Drawing it at 40px and scaling to
     0.5 doubles the raster resolution and it stays sharp. */
  .cube .lbl b{font-family:'Anton','Arial Narrow',Impact,sans-serif;font-weight:400;
               font-size:44px;letter-spacing:.04em;color:#12171D;line-height:1;
               white-space:nowrap;-webkit-font-smoothing:antialiased;
               /* Black face, WHITE extrusion. Against a busy illustration a coloured glyph
                  competes with the artwork; black reads as type at any backdrop, and the
                  white depth doubles as the separation that would otherwise need a halo.
                  Drawn at 2x with the font, so these offsets are 2x too. */
               text-shadow:2px 2px 0 #FFFFFF, 3px 3px 0 #FFFFFF, 4px 4px 0 #F6F8FC,
                           5px 5px 0 #EDF0F6, 6px 8px 10px rgba(70,80,100,.30),
                           -1px -1px 0 rgba(255,255,255,.85)}

  @@media(prefers-reduced-motion:reduce){ .cube-stage{cursor:default} }

  .meta{font-family:var(--mono);font-size:11px;color:var(--faint);letter-spacing:.04em}
  .crumb{font-family:var(--mono);font-size:11.5px;letter-spacing:.08em;color:var(--faint2);margin-bottom:18px}
  .empty{padding:70px 0;text-align:center;color:var(--faint2)}

  footer.site{background:var(--navy);color:var(--navy-t);border-top:0;margin-top:0}
  footer.site .cols{max-width:1320px;margin:0 auto;padding:clamp(48px,6vw,72px) clamp(16px,3vw,40px) 0;
                    display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:56px}
  footer.site .ftitle{font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;color:#aebde3;margin-bottom:20px}
  footer.site .stack{display:flex;flex-direction:column;gap:12px;font-size:14px}
  footer.site .stack a{color:var(--navy-t)} footer.site .stack a:hover{color:#fff}
  footer.site .addr{display:flex;flex-direction:column;gap:10px;font-size:13.5px;line-height:1.8;
                    color:var(--navy-t);font-weight:300}
  footer.site .base{max-width:1320px;margin:0 auto;padding:36px clamp(16px,3vw,40px);
                    border-top:1px solid var(--line);margin-top:56px;display:flex;justify-content:space-between;
                    gap:16px;flex-wrap:wrap;font-family:var(--mono);font-size:11px;color:var(--faint)}

  #side-rail{position:fixed;right:0;top:50%;transform:translateY(-50%);z-index:30;
             display:flex;flex-direction:column;background:var(--card);border:1px solid var(--line2)}
  #side-rail a{writing-mode:vertical-rl;padding:14px 9px;font-size:12px;color:var(--muted2);letter-spacing:.1em}
  #side-rail a+a{border-top:1px solid var(--line2)}
  #side-rail a:hover{background:var(--panel2);color:var(--brand)}
  @@media(max-width:1120px){#side-rail{display:none}}

  .navtoggle{display:none;background:none;border:0;cursor:pointer;padding:9px;width:44px;height:44px;
             flex-direction:column;justify-content:center;gap:5px}
  .navtoggle span{display:block;height:2px;width:22px;background:var(--ink2);transition:.25s}
  .navtoggle.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
  .navtoggle.open span:nth-child(2){opacity:0}
  .navtoggle.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
  .navpanel{display:none;width:100%;padding-bottom:12px}
  .navpanel a{display:block;padding:10px 2px;font-size:15px;color:var(--muted3);border-bottom:1px solid var(--line)}
  @@media(max-width:1060px){
    nav.main{display:none}
    .navtoggle{display:flex}
    .navpanel.open{display:block}
  }
</style>
</head>
<body>

<div class="utility">
  <div class="shell">
    <span class="org">@Ui.T(lang,"orgLine")</span>
    <div class="util-right">
      <div class="langsel">
        @foreach (var l in IitsNews.Data.Lang.All)
        {
          <a href="@LangHref(l)" class="@(l == lang ? "on" : "")" hreflang="@l">@IitsNews.Data.Lang.Short(l)</a>
        }
      </div>
      <span class="vr"></span>
      <a href="https://iits.giftedintl.com/student/" style="color:var(--muted2)">@Ui.T(lang,"student")</a>
      <a href="https://iits.giftedintl.com/teacher/" style="letter-spacing:.08em">@Ui.T(lang,"teacher") →</a>
    </div>
  </div>
</div>

<header class="site">
  <div class="shell">
    <a href="/?lang=@lang" aria-label="@Ui.T(lang,"siteName")">
      <img src="/assets/iits-logo.png@(Ui.V("/assets/iits-logo.png"))" alt="@Ui.T(lang,"siteName")">
    </a>
    <nav class="main">
      @* Five categories, not the old CMS's fifty sections. Assessments and Programmes carry
         a dropdown; News, Experts and About are single destinations. *@
      <a href="/?lang=@lang" class="@(path == "/" ? "on" : "")">@Ui.T(lang,"home")</a>
      @foreach (var cd in IitsNews.Services.Taxonomy.All)
      {
        <div class="item">
          <a href="/c/@cd.Key?lang=@lang" class="@(path.StartsWith($"/c/{cd.Key}") || (cd.Key=="experts" && path=="/experts") ? "on" : "")">@IitsNews.Services.Taxonomy.Name(cd, lang)</a>
          @if (cd.Subs.Length > 0)
          {
            <div class="drop">
              @foreach (var sd in cd.Subs)
              {
                <a href="/c/@cd.Key/@sd.Key?lang=@lang">@IitsNews.Services.Taxonomy.Name(sd, lang)</a>
              }
            </div>
          }
        </div>
      }
    </nav>
    <button class="navtoggle" id="navToggle" aria-label="menu" aria-expanded="false"><span></span><span></span><span></span></button>
    <div class="navpanel" id="navPanel">
      <a href="/?lang=@lang">@Ui.T(lang,"home")</a>
      @foreach (var cd in IitsNews.Services.Taxonomy.All)
      {
        <a href="/c/@cd.Key?lang=@lang">@IitsNews.Services.Taxonomy.Name(cd, lang)</a>
        foreach (var sd in cd.Subs) { <a class="sub" href="/c/@cd.Key/@sd.Key?lang=@lang">@IitsNews.Services.Taxonomy.Name(sd, lang)</a> }
      }
    </div>
  </div>
</header>

@RenderBody()

<footer class="site">
  <div class="cols">
    <div>
      <img src="/assets/iits-logo.png@(Ui.V("/assets/iits-logo.png"))" alt="" style="height:52px;width:auto;display:block;margin-bottom:24px">
      <div class="addr">
        <span>@Ui.T(lang,"ftWeb")</span>
        <span>@Ui.T(lang,"ftTel")</span>
        <span>@Ui.T(lang,"ftMail")</span>
        <span>@Ui.T(lang,"ftHours")</span>
        <span>@Ui.T(lang,"ftAddr")</span>
        <span style="color:var(--faint2)">Room 24, 3/F, Building 2W, 2 Science Park West Avenue, Hong Kong Science Park</span>
      </div>
    </div>
    @foreach (var cd in IitsNews.Services.Taxonomy.All.Where(x => x.Subs.Length > 0))
    {
      <div>
        <div class="ftitle">@IitsNews.Services.Taxonomy.Name(cd, lang)</div>
        <div class="stack">
          @foreach (var sd in cd.Subs) { <a href="/c/@cd.Key/@sd.Key?lang=@lang">@IitsNews.Services.Taxonomy.Name(sd, lang)</a> }
        </div>
      </div>
    }

  </div>
  <div class="base">
    <span>© @DateTime.Now.Year @Ui.T(lang,"siteName")</span>
    <span>@Ui.T(lang,"staging")</span>
  </div>
</footer>

<div id="side-rail">
  <a href="https://iits.giftedintl.com/student/">@Ui.T(lang,"student")</a>
  <a href="https://iits.giftedintl.com/teacher/">@Ui.T(lang,"teacher")</a>
</div>

<script>
  var t=document.getElementById('navToggle'), p=document.getElementById('navPanel');
  if(t){t.addEventListener('click',function(){var o=p.classList.toggle('open');
    t.classList.toggle('open',o); t.setAttribute('aria-expanded',o);});}
</script>
</body>
</html>
