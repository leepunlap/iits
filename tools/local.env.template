# Local dev environment for the IITS teaching stack.
# Sourced by restart.sh / update.sh; the values point every service at THIS tree instead of
# the production paths baked into their defaults (/etc/..., /var/...), which do not exist on a Mac.
#
# Generated by tools/bootstrap.sh — __ROOT__ is replaced with the tree's absolute path.

# --- portal auth / file gate (checker.py :8790) ---
IITS_AUTH_CFG=__ROOT__/config/auth          # server_secret + {users,students,admins}.json
IITS_REG_DATA=__ROOT__/config/reg           # self-registered {teachers,students}.json + classes.db
IITS_CLASSDIR=__ROOT__/classfiles           # L1..L4 lesson sites + _library
PORT=8790

# The teacher realm refuses a SELF-REGISTERED teacher unless the request's Host equals this one
# (checker.usable()). Production defaults to teachers.ycltesthk.com; here it must be the dev name,
# or every registered production teacher — the owner's account included — is refused with
# {"error":"portal"} even though the password is right.
PORTAL_TEACHER_HOST=teachers-dev.roadlogica.com

# --- lesson AI 學伴 (lesson_ai.py :8811) ---
LESSON_AI_CFG=__ROOT__/service-config       # config.json (hours, caps, models)
LESSON_AI_DATA=__ROOT__/data/lesson-ai      # usage.db
LESSON_AI_PORT=8811

# The model key lives in service-config/deepseek.env and is sourced separately by restart.sh,
# so it is never duplicated here.

# --- Wonder Lab hardware build service (blocks -> Arduino sketch -> compile) :18811 ---
# build_service.mjs reads PORT, ARDUINO_CLI and ARDUINO_CONFIG. PORT must NOT be the shared PORT
# above (that is the checker, :8790) — production pins it with Environment=PORT=18811 in the systemd
# unit, so restart.sh passes PORT="$BUILD_PORT" explicitly when it launches this one service.
# The production defaults (arduino-cli on PATH, $HOME/.arduino15/cli-uc.yaml) do not exist on a Mac,
# where the toolchain lives under ~/Library/Arduino15; point ARDUINO_CONFIG at the tree's own copy.
BUILD_PORT=18811
ARDUINO_CLI=/opt/homebrew/bin/arduino-cli
ARDUINO_CONFIG=__ROOT__/config/arduino-cli.yaml
