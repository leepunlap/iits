# The two DEV lesson hosts, pointed at the local copies by /etc/hosts.
#
# WHY -dev.roadlogica.com AND NOT THE PRODUCTION NAMES (owner, 2026-10-14): an /etc/hosts entry for
# students.ycltesthk.com / teachers.ycltesthk.com SHADOWS the live sites on whichever machine holds
# it, so you can no longer open production from that laptop — and a shadowed teacher host was
# mistaken for a production outage. The dev names live under roadlogica.com (wildcard DNS, covered
# by certs/roadlogica.*), so production keeps resolving to the NUC everywhere.
#
# WHY TWO SERVER BLOCKS: this file used to declare ONE block with
#   server_name students.ycltesthk.com teachers.ycltesthk.com;  root __ROOT__/portals/students;
# which meant the teacher portal was unreachable on every bootstrapped machine — https://teachers.
# ycltesthk.com/ served the STUDENT tree (and, because /etc/hosts shadowed that name, it looked like
# a production outage). Production has always had two blocks with two roots (see portals/nginx/), so
# the local copy was silently unfaithful. Keep them separate, and keep the realm header per block:
# the checker picks its realm from X-Auth-Realm, and its default is "teacher".
#
# tools/check-local-hosts.sh asserts this shape (rule VII: the mistake happened, so the check exists).

# --- http: send both names to https -----------------------------------------
server {
    listen      80;
    listen      [::]:80;
    server_name students-dev.roadlogica.com teachers-dev.roadlogica.com;
    return 301 https://$host$request_uri;
}

# --- https: TEACHERS ---------------------------------------------------------
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name teachers-dev.roadlogica.com;

    # The real *.ycltesthk.com Let's Encrypt wildcard, copied from the NUC by tools/refresh-certs.sh
    # (so the browser trusts it with no warning). It EXPIRES — re-copy before it lapses; the other
    # three wildcards (giftedintl / roadlogica / supercert) are in certs/ for any local vhost.
    ssl_certificate     __ROOT__/certs/roadlogica.fullchain.pem;
    ssl_certificate_key __ROOT__/certs/roadlogica.key;

    root __ROOT__/portals/teachers;
    index index.html;

    location = /_verify  { internal; proxy_pass http://127.0.0.1:__PORT_AUTH__/verify;
                           proxy_pass_request_body off; proxy_set_header Content-Length "";
                           proxy_set_header Cookie $http_cookie; proxy_set_header Host $host;
                           proxy_set_header X-Auth-Realm teacher; }
    location = /_fverify { internal; proxy_pass http://127.0.0.1:__PORT_AUTH__/fverify;
                           proxy_pass_request_body off; proxy_set_header Content-Length "";
                           proxy_set_header Cookie $http_cookie; proxy_set_header Host $host;
                           proxy_set_header X-Auth-Realm teacher;
                           proxy_set_header X-Original-URI $request_uri; }

    # public pages
    location = /login.html    { add_header Cache-Control "no-cache, no-store, must-revalidate"; }
    location = /register.html { add_header Cache-Control "no-cache, no-store, must-revalidate"; }
    location = /forgot.html   { add_header Cache-Control "no-cache, no-store, must-revalidate"; }
    location = /favicon.ico   { access_log off; log_not_found off; return 204; }
    location /assets/         { add_header Cache-Control "public, max-age=300"; }

    # per-level file gate: the checker reads files/<level>/<section>/… out of the URI
    location ~ ^/files/([^/]+)/([^/]+)/(.+)$ {
        auth_request /_fverify;
        error_page 401 = @login;
        alias __ROOT__/classfiles/$1/$2/$3;
        gzip_static on;
    }
    # the UCMake / OpenBlock actor + stage library (same origin on purpose: the Studio draws
    # costumes to a canvas and a cross-origin asset would taint it)
    location /files/ { return 404; }
    location /lab-library/    { auth_request /_verify; error_page 401 = @login;
                                alias __ROOT__/classfiles/_library/;
                                add_header Cache-Control "public, max-age=604800"; }

    # lesson AI 學伴 (:__PORT_AI__) — scoped per lesson by the path, gated per level
    # AI 學伴 (:__PORT_AI__). The path carries files/<LEVEL>/lessons/<slug>, so the existing per-level
    # gate decides access and hands over the verified user. These three headers are NOT optional:
    # without auth_request_set the service sees no X-Auth-User and answers 404 for every lesson.
    location ~ ^/api/ai/(chat|status)/files/(L[1-4])/lessons/([a-z0-9]+-bp[0-9]+)$ {
        auth_request /_fverify; error_page 401 = @login;
        auth_request_set $auth_user $upstream_http_x_auth_user;
        client_max_body_size 24k;
        proxy_read_timeout 60s;
        proxy_pass http://127.0.0.1:__PORT_AI__/$1/files/$2/lessons/$3;
        proxy_set_header X-Auth-User $auth_user;
        proxy_set_header Cookie "";
        proxy_set_header X-Auth-Realm teacher;
    }
    # Wonder Lab (L4 vibe coding): GET = availability + last program, POST = one lab turn
    location ~ ^/api/ai/lab/files/(L4)/lessons/([a-z0-9]+-bp[0-9]+)$ {
        auth_request /_fverify; error_page 401 = @login;
        auth_request_set $auth_user $upstream_http_x_auth_user;
        client_max_body_size 96k;
        proxy_read_timeout 60s;
        proxy_pass http://127.0.0.1:__PORT_AI__/lab/files/$1/lessons/$2;
        proxy_set_header X-Auth-User $auth_user;
        proxy_set_header X-Auth-Realm teacher;
        proxy_set_header Cookie "";
    }
    # Wonder Lab 課堂控制 — teacher only, no lesson in the path so it uses the plain login gate
    location ~ ^/api/ai/lab/teacher/([A-Za-z0-9][A-Za-z0-9_-]*)(/[a-z0-9]+-bp[0-9]+)?$ {
        auth_request /_verify; error_page 401 = @login;
        auth_request_set $auth_user $upstream_http_x_auth_user;
        client_max_body_size 8k;
        proxy_read_timeout 20s;
        proxy_pass http://127.0.0.1:__PORT_AI__/lab/teacher/$1$2;
        proxy_set_header X-Auth-User $auth_user;
        proxy_set_header X-Auth-Realm teacher;
        proxy_set_header Cookie "";
    }
    # AI 遊樂場 — free-form AI coding in the teachers portal (no lesson), longer read timeout
    location = /api/ai/lab/playground {
        auth_request /_verify; error_page 401 = @login;
        auth_request_set $auth_user $upstream_http_x_auth_user;
        client_max_body_size 96k;
        proxy_read_timeout 120s;
        proxy_pass http://127.0.0.1:__PORT_AI__/lab/playground;
        proxy_set_header X-Auth-User $auth_user;
        proxy_set_header X-Auth-Realm teacher;
        proxy_set_header Cookie "";
    }
    # no file-manager writes from the portal (production serves this 403 for the same reason)
    location ~ ^/api/fm/(upload|delete|rename)$ { return 403; }
    location /api/ { proxy_pass http://127.0.0.1:__PORT_AUTH__/;
                     proxy_set_header Host $host; proxy_set_header X-Auth-Realm teacher;
                     proxy_cookie_path /teacher/ /; }

    location / { auth_request /_verify; error_page 401 = @login;
                 try_files $uri $uri/ =404; add_header Cache-Control "no-store"; }
    location @login { return 302 /login.html; }
}

# --- https: STUDENTS ---------------------------------------------------------
